import type { Options } from "vis-network";
import type {
  Automaton,
  AutomatonExecution,
  AutomatonState,
  AutomatonTransition,
} from "@/components/automata/model";

export type AutomatonNetworkTheme = {
  background: string;
  border: string;
  foreground: string;
  muted: string;
  primary: string;
  success: string;
  highlighted: string;
};

export type VisNode = Record<string, unknown>;
export type VisEdge = Record<string, unknown>;

type CustomNodeRendererArgs = {
  ctx: CanvasRenderingContext2D;
  label?: string;
  style: {
    borderColor: string;
    borderWidth: number;
    color: string;
    size: number;
  };
  x: number;
  y: number;
};

/**
 * vis-network has no built-in double-circle shape, so accepting states use
 * its supported custom-node hook. Layout, hit testing, and edge routing still
 * remain owned by vis-network.
 */
function acceptingStateRenderer(fontColor: string) {
  return ({ ctx, label, style, x, y }: CustomNodeRendererArgs) => {
    const radius = style.size;

    return {
      drawNode: () => {
        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        ctx.fillStyle = style.color;
        ctx.fill();
        ctx.strokeStyle = style.borderColor;
        ctx.lineWidth = style.borderWidth;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(x, y, Math.max(radius - 5, 1), 0, Math.PI * 2);
        ctx.lineWidth = Math.max(1.5, style.borderWidth - 0.5);
        ctx.stroke();

        ctx.fillStyle = fontColor;
        ctx.font = "600 16px Arial, sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(label ?? "", x, y);
      },
      nodeDimensions: { width: radius * 2, height: radius * 2 },
    };
  };
}

function stateStatus(
  state: AutomatonState,
  execution: AutomatonExecution,
) {
  if (execution.activeStateIds.includes(state.id)) return "active";
  if (state.status === "highlighted") return "highlighted";
  if (execution.visitedStateIds.includes(state.id) || state.status === "visited") {
    return "visited";
  }
  return state.status ?? "normal";
}

function transitionStatus(
  transition: AutomatonTransition,
  execution: AutomatonExecution,
) {
  if (execution.activeTransitionIds.includes(transition.id)) return "active";
  if (transition.status === "highlighted") return "highlighted";
  if (
    execution.visitedTransitionIds.includes(transition.id) ||
    transition.status === "visited"
  ) {
    return "visited";
  }
  return transition.status ?? "normal";
}

function stateColors(
  state: AutomatonState,
  execution: AutomatonExecution,
  theme: AutomatonNetworkTheme,
) {
  switch (stateStatus(state, execution)) {
    case "active":
      return { background: theme.primary, border: theme.primary, font: "#ffffff" };
    case "highlighted":
      return {
        background: theme.highlighted,
        border: theme.highlighted,
        font: "#ffffff",
      };
    case "visited":
      return { background: theme.background, border: theme.muted, font: theme.muted };
    default:
      return { background: theme.background, border: theme.border, font: theme.foreground };
  }
}

function edgeStyle(
  transitions: AutomatonTransition[],
  execution: AutomatonExecution,
  theme: AutomatonNetworkTheme,
) {
  const statuses = transitions.map((transition) => transitionStatus(transition, execution));
  const status = statuses.includes("active")
    ? "active"
    : statuses.includes("highlighted")
      ? "highlighted"
      : statuses.includes("visited")
        ? "visited"
        : "normal";
  switch (status) {
    case "active":
      return { color: theme.primary, width: 3 };
    case "highlighted":
      return { color: theme.highlighted, width: 3 };
    case "visited":
      return { color: theme.muted, width: 1.5 };
    default:
      return { color: theme.foreground, width: 1.6 };
  }
}

function transitionLabel(transitions: AutomatonTransition[]) {
  return [...new Set(transitions.flatMap((transition) => transition.symbols))].join(", ");
}

/** Place states by reachability so cycles and self-loops cannot turn a DFA vertical. */
function statePositions(automaton: Automaton) {
  const ids = new Set(automaton.states.map((state) => state.id));
  const levels = new Map<string, number>();
  const start = ids.has(automaton.startState)
    ? automaton.startState
    : automaton.states[0]?.id;
  const pending = start ? [start] : [];
  if (start) levels.set(start, 0);

  for (let index = 0; index < pending.length; index++) {
    const from = pending[index];
    for (const transition of automaton.transitions) {
      if (transition.from !== from || !ids.has(transition.to) || levels.has(transition.to)) {
        continue;
      }
      levels.set(transition.to, (levels.get(from) ?? 0) + 1);
      pending.push(transition.to);
    }
  }

  const lastLevel = Math.max(0, ...levels.values());
  for (const state of automaton.states) {
    if (!levels.has(state.id)) levels.set(state.id, lastLevel + 1);
  }

  const columns = new Map<number, string[]>();
  for (const state of automaton.states) {
    const level = levels.get(state.id) ?? 0;
    columns.set(level, [...(columns.get(level) ?? []), state.id]);
  }

  const positions = new Map<string, { x: number; y: number }>();
  for (const [level, stateIds] of columns) {
    stateIds.forEach((id, index) => {
      positions.set(id, {
        x: level * 230,
        y: (index - (stateIds.length - 1) / 2) * 170,
      });
    });
  }
  return positions;
}

/**
 * The only vis-network-specific mapping. The domain model stays portable if a
 * different canvas renderer is ever selected.
 */
export function toVisNetworkData(
  automaton: Automaton,
  execution: AutomatonExecution,
  theme: AutomatonNetworkTheme,
): { nodes: VisNode[]; edges: VisEdge[] } {
  const positions = statePositions(automaton);
  const nodes: VisNode[] = automaton.states.map((state) => {
    const colors = stateColors(state, execution, theme);
    const size = Math.max(32, Math.min(46, 24 + state.label.length * 4));
    return {
      id: state.id,
      label: state.label,
      ...positions.get(state.id),
      fixed: { x: true, y: true },
      shape: state.accepting ? "custom" : "circle",
      ...(state.accepting
        ? { ctxRenderer: acceptingStateRenderer(colors.font) }
        : {}),
      size,
      borderWidth: stateStatus(state, execution) === "active" ? 3 : 2,
      color: { background: colors.background, border: colors.border },
      font: { color: colors.font, face: "Arial, sans-serif", size: 18 },
    };
  });

  // Several symbols between the same states belong on one readable arrow.
  const groups = new Map<string, AutomatonTransition[]>();
  for (const transition of automaton.transitions) {
    const key = JSON.stringify([transition.from, transition.to]);
    groups.set(key, [...(groups.get(key) ?? []), transition]);
  }

  const edges: VisEdge[] = [];
  const xValues = [...positions.values()].map((position) => position.x);
  const midpoint = xValues.length
    ? (Math.min(...xValues) + Math.max(...xValues)) / 2
    : 0;
  for (const [key, transitions] of groups) {
    const { from, to } = transitions[0];
    const isLoop = from === to;
    const hasReverse = !isLoop && groups.has(JSON.stringify([to, from]));
    const style = edgeStyle(transitions, execution, theme);
    const loopAngle = (positions.get(from)?.x ?? 0) <= midpoint
      ? (3 * Math.PI) / 4
      : Math.PI / 4;

    edges.push({
      id: `automaton-edge:${key}`,
      from,
      to,
      label: transitionLabel(transitions),
      arrows: { to: { enabled: true, scaleFactor: 0.85 } },
      color: { color: style.color, highlight: style.color, hover: style.color },
      width: style.width,
      font: {
        color: style.color,
        face: "Arial, sans-serif",
        size: 14,
        align: "top",
        strokeWidth: 4,
        strokeColor: theme.background,
      },
      selfReference: isLoop ? { size: 36, angle: loopAngle } : undefined,
      smooth: hasReverse
        ? { enabled: true, type: "curvedCW", roundness: 0.27 }
        : false,
    });
  }

  const initial = automaton.states.find((state) => state.id === automaton.startState);
  if (initial) {
    const helperId = `__automaton_start__${initial.id}`;
    const initialPosition = positions.get(initial.id) ?? { x: 0, y: 0 };
    nodes.push({
      id: helperId,
      x: initialPosition.x - 145,
      y: initialPosition.y,
      fixed: { x: true, y: true },
      label: "",
      shape: "dot",
      size: 1,
      color: { background: "transparent", border: "transparent" },
      font: { color: "transparent" },
    });
    edges.push({
      id: `${helperId}→${initial.id}`,
      from: helperId,
      to: initial.id,
      arrows: { to: { enabled: true, scaleFactor: 0.9 } },
      color: { color: theme.foreground },
      width: 1.8,
      smooth: false,
    });
  }

  return { nodes, edges };
}

export const automatonNetworkOptions = {
  autoResize: true,
  physics: false,
  interaction: {
    dragNodes: false,
    dragView: false,
    hover: true,
    keyboard: false,
    navigationButtons: false,
    zoomView: false,
  },
  nodes: { margin: { top: 10, right: 10, bottom: 10, left: 10 } },
  edges: { selectionWidth: 0 },
} satisfies Options;
