# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — root-anchored patterns don't reach into apps/*/ or
# packages/*/, so each workspace member needs its own line.
/node_modules
apps/*/node_modules
packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — same root-anchoring issue: the app now lives at apps/web/, not
# the repo root.
/.next/
apps/*/.next/
/out/
apps/*/out/

# production
/build
apps/*/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# turborepo — local task cache, one per workspace member plus the root.
.turbo

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
